"""Spatial Media Metadata Injector - Standalone Cross-Platform Script

A standalone command-line tool for examining and injecting spatial media
metadata (360° video and spatial audio) into MP4/MOV files.

This script works on any platform with Python 3 installed, including:
- macOS (Intel and Apple Silicon)
- Windows
- Linux

No binary compilation required!
"""

import sys
import os

# Add the parent directory to the path so we can import spatialmedia
script_dir = os.path.dirname(os.path.abspath(__file__))
sys.path.insert(0, script_dir)

from spatialmedia.__main__ import main

if __name__ == "__main__":
    main(sys.argv[1:])
